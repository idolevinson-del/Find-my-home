# Copy to .env and fill in. .env is gitignored — never commit secrets.

# Telegram: create a bot with @BotFather, message it once, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Google AI Studio key for listing analysis (roommate fit, condition, red flags)
GEMINI_API_KEY=

# Minutes between automatic scans (minimum 5). Overrides config.yaml.
SCAN_INTERVAL_MINUTES=15

# Dashboard port
PORT=3000
